# Dependencies
node_modules/

# Build output
dist/

# Studio bundles built by scripts/build-studios.mjs (prebuild) from each
# Studio's main.jsx — one per Studio, plus its source map. Only *.bundle.js:
# these folders also hold hand-written .js (riso-engine.js, studio-store.js,
# cloud-client.js, print-store.js, vendor/*) that MUST stay tracked.
public/*/*.bundle.js
public/*/*.bundle.js.map

# Vite's transient config-loader artifacts (left behind if a build is killed)
vite.config.js.timestamp-*.mjs

# Design-system bundle zips — large binaries, regenerate from
# design-system-year2/ with: python tools/zip-bundle.py
*.zip

# Environment and secrets
.env
.env.*
*.local

# Plan and internal docs (contain references to secrets/infrastructure)
FORMS-INTEGRATION-PLAN.md

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code git worktrees — transient; never commit (they land as bare
# gitlinks with no .gitmodules and break checkout / Cloudflare Pages builds).
.claude/worktrees/

# Generated at prebuild by scripts/build-seo-files.mjs (dated + live events),
# so tracking them would dirty the tree on every build. CI regenerates them.
public/sitemap.xml
public/llms.txt
public/llms-full.txt

# Studio test suites (scripts/test-studios): renders + diff images from the
# last failing run. Goldens (tests/golden/) and fixtures ARE tracked.
tests/out/
