# Response headers for the site (Cloudflare Pages `_headers`).
#
# Why this file exists
# --------------------
# Cloudflare Pages honors a `_headers` file at the site root. It lives in
# public/ so Vite copies it verbatim into dist/.
#
# How rules combine (read before adding one)
# ------------------------------------------
# A request inherits the headers of EVERY rule whose path matches — they are
# not first-match. A header set by two matching rules is joined with a comma,
# which is how /assets/* used to ship
#   Cache-Control: public, max-age=31536000, immutable, public, max-age=0, must-revalidate
# So the catch-all /* below deliberately sets NO Cache-Control: HTML gets
# Pages' own default (public, max-age=0, must-revalidate — always revalidate,
# so pre-rendered pages update on deploy), and each specific block below is
# the only rule that sets Cache-Control for its paths. Keep it that way: add
# Cache-Control to specific paths only.
#
# Strategy
# --------
# Hashed build assets (JS / CSS emitted by Vite into /assets/) are immutable —
# the content hash changes when the contents change, so we cache them forever.
# Static assets with stable filenames (images, PDFs) get a day of caching.
# Internal tools revalidate on every load.

# Every response: security headers. HSTS without includeSubDomains — not
# every realitydn.com subdomain is known to be HTTPS-only.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The pages.dev hostnames (production alias + per-deploy previews) duplicate
# realitydn.com — keep them out of every index.
https://realitydn.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:deployment.realitydn.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Immutable hashed build output — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images served from /images/ (event posters, gallery, hero). Stable URLs but
# we do occasionally replace files without renaming — a day is a good balance.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

# PDFs (menus). Same reasoning as images.
/*.pdf
  Cache-Control: public, max-age=86400, must-revalidate

# Favicons — rarely change. A week.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Internal staff drafts. Unlisted pages carry a hard noindex at the edge as well
# as in the document — a meta tag alone loses to a link shared into a crawler's
# path. Also absent from sitemap.xml and Disallowed in robots.txt.
/sidework-points/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: public, max-age=0, must-revalidate

# Internal editors and their shared kit (Poster / Print / Schedule Studio,
# event report, tokens). Not for search; and their un-hashed .js/.css must
# revalidate on every load so a deploy is picked up immediately.
/studio/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/print/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/schedule/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/event-report/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/tokens/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/studio-shared/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Build-time copy of the events feed — data for the page, not a document.
/feed-snapshot.json
  X-Robots-Tag: noindex, nofollow

# Sitemap + robots + llms files — check every hour so updates propagate quickly.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
